# Sous-domaine obfusqué pour le dashboard Traefik (évitez traefik.alsek.fr)
TRAEFIK_DASHBOARD_DOMAIN=edge-ctrl.alsek.fr

# Couple utilisateur:mot_de_passe_haché (Généré avec htpasswd -nb admin VotreMotDePasse)
# Attention : dans un fichier .env appelé par docker-compose ou labels, si vous mettez directement dans docker-compose il faut doubler les $, mais dans un fichier .env chargé comme variable, vérifiez la syntaxe :
TRAEFIK_BASIC_AUTH=admin:$$2y$$05$$ExempleDeHashBcryptARemplacerSurLeServeur
